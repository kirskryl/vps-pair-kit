# Native HOME apps only. Rendered proxy.env fills the selected port.
HTTP_PROXY=http://127.0.0.1:__PROXY_PORT__
HTTPS_PROXY=http://127.0.0.1:__PROXY_PORT__
http_proxy=http://127.0.0.1:__PROXY_PORT__
https_proxy=http://127.0.0.1:__PROXY_PORT__
NO_PROXY=localhost,127.0.0.1,::1
no_proxy=localhost,127.0.0.1,::1
# SDK must explicitly support proxy and must not fall back to direct.
